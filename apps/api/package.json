{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "echo no lint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --config jest.e2e.json --passWithNoTests",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "content:sync": "ts-node -P tsconfig.json src/content/content-sync.cli.ts",
    "mail:test": "ts-node -P tsconfig.json src/mail/mail.cli.ts",
    "mastery:replay": "ts-node -P tsconfig.json src/learning/mastery-replay.cli.ts"
  },
  "dependencies": {
    "@app/types": "workspace:*",
    "@app/validation": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "zod": "^3.25.76",
    "@app/content": "workspace:*",
    "highlight.js": "^11.11.0",
    "markdown-it": "^14.1.0",
    "sanitize-html": "2.13.1",
    "@app/learning-engine": "workspace:*",
    "@nestjs/jwt": "^11.0.0",
    "@node-rs/argon2": "^2.0.2",
    "bullmq": "^5.34.6",
    "nodemailer": "^6.9.16",
    "nestjs-zod": "^5.5.0"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "@types/markdown-it": "^14.1.2",
    "@types/sanitize-html": "^2.13.0",
    "@types/nodemailer": "^6.4.17",
    "@types/express": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$"
  }
}
