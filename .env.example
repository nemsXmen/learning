# --- apps/api -------------------------------------------------------------
PORT=3001
DATABASE_URL=postgres://learn:learn@localhost:5432/learning
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-to-32-random-bytes-minimum
JWT_REFRESH_SECRET=change-me-to-another-32-random-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CONTENT_DIR=../../content
WEB_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# Mail — Mailpit locally, real SMTP when deployed
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Atelier <no-reply@example.com>
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=60m

# --- apps/web -------------------------------------------------------------
# Server-side only. Never prefix a credential with NEXT_PUBLIC_.
API_BASE_URL=http://localhost:3001
SESSION_COOKIE_SECURE=false
